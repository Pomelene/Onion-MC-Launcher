# Publish source by allowlist; keep credentials and local game data out.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/LICENSE
!/SECURITY.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/requirements-dev.txt
!/requirements-thunion.txt
!/main.py
!/main_tk.py
!/launcher/
!/tests/
!/scripts/
!/packaging/
!/assets/
!/docs/
__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key
*.pfx
*.p12
accounts.json
settings.json
**/.craftbridge-backups/
**/.craftbridge-trash/
/assets/*
!/assets/craftbridge.ico
!/assets/microsoft-app.example.json
!/assets/native/
/assets/native/*
!/assets/native/onion_seedmap.dll
/docs/*
!/docs/development.md
!/docs/microsoft-auth.md
!/docs/ui-motion-audit.md
!/docs/ui-copy-audit.md
!/docs/next-features.md
!/docs/launcher-updates.md

# Portable user data and build output must never be published.
onionmcl.json
/release/
.onion/
